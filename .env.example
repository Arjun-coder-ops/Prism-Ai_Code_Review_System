# PRISM local configuration. Copy this file to .env; do not commit real credentials.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
DIRECT_DATABASE_URL=postgresql+asyncpg://prism:prism@localhost:5432/prism
REDIS_URL=redis://localhost:6379/0
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT=10
# Configure these only when enabling the review-analysis provider adapters.
GROQ_API_KEY=
GEMINI_API_KEY=
GITHUB_WEBHOOK_SECRET=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.5-flash
POSTGRES_DB=prism
POSTGRES_USER=prism
POSTGRES_PASSWORD=prism
